APP_HOST=127.0.0.1
APP_PORT=8000
# Hosted access is disabled for local development. Provision secrets outside Git.
HOSTED_AUTH_ENABLED=false
HOSTED_PASSWORD_HASH=
HOSTED_SESSION_SECRET=
PUBLIC_APP_ORIGIN=
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
ALLOWED_REPOSITORY_ROOTS=
SNAPSHOT_CACHE_DIR=.codegraph-cache/snapshots
EMBEDDING_CACHE_DIR=.codegraph-cache/embeddings
HOSTED_EMBEDDING_ENABLED=false
HOSTED_EMBEDDING_COST_PER_MILLION_TOKENS_USD=0.02
MAX_HOSTED_EMBEDDING_RUN_COST_USD=0.50
OPENAI_API_KEY=
LOCAL_QUERY_ANALYZER_ENABLED=true
LOCAL_QUERY_ANALYZER_URL=http://127.0.0.1:11434
LOCAL_QUERY_ANALYZER_MODEL=qwen2.5:0.5b
FAILED_SNAPSHOT_GC_GRACE_SECONDS=604800
MAX_SOURCE_FILE_BYTES=1048576
RUNTIME_DOCKER_BIN=docker
RUNTIME_CONTAINER_IMAGE=
RUNTIME_TIMEOUT_SECONDS=300
RUNTIME_MEMORY_MB=1024
RUNTIME_CPU_COUNT=1.0
RUNTIME_PIDS_LIMIT=128
RUNTIME_OUTPUT_LIMIT_BYTES=1048576
M21_MAX_COMMIT_BLOB_BYTES=33554432
M21_MAX_COMMIT_MATERIALIZED_BYTES=268435456
M21_COMMIT_MATERIALIZATION_TIMEOUT_SECONDS=120
SCIP_PYTHON_BIN=node_modules/.bin/scip-python
SCIP_CLI_BIN=.tools/scip/scip
# Optional frontend build settings. Public deployments need a reachable API URL.
VITE_CODEGRAPH_API_BASE_URL=http://127.0.0.1:8000
# Prefer an existing READY demonstration snapshot at first load; no ingestion is triggered.
VITE_CODEGRAPH_DEMO_SNAPSHOT_ID=
